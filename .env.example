# Environment variables for Smart Traffic Simulator
# Copy this file to .env and configure your MySQL credentials if available.

# Database Configuration
# Supported drivers: sqlite, mysql
DB_TYPE=sqlite
DB_SQLITE_PATH=results/traffic_results.sqlite3

# MySQL Configuration (used if DB_TYPE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=smart_traffic_db

# Simulation Defaults
SUMO_HOME=C:\Program Files (x86)\Eclipse\Sumo
DEFAULT_SIM_SECONDS=300
DEFAULT_SEED=42
