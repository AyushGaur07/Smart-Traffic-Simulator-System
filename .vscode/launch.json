{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "▶ Run Traffic Dashboard (GUI)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/gui_app.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "▶ Run Interactive CLI Menu",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "📊 Run 4-Controller Benchmark",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--mode", "benchmark", "--seconds", "300", "--seed", "42"],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "🧪 Run Unit Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": ["tests/test_traffic_system.py"],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}
